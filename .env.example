# Optional environment values read by config.py.
# Export them in your shell or load this file with your preferred environment tool.
# Copy to .env.local and set locations on your machine; never commit local paths.
# Leave unset to use paths relative to this checkout.
# BAZZA_ROOT=/path/to/runtime
# BAZZA_PROJECT_ROOT=/path/to/projects       # optional project parent
# BAZZA_DATA_ROOT=/path/to/prepared-data
# BAZZA_CACHE_ROOT=/path/to/features/bazza
# BAZZA_MODEL_ROOT=/path/to/model-weights
# BAZZA_RUN_ROOT=/path/to/runs/bazza
# BAZZA_SELECTION_PATH=/path/to/existing/selection.json
# OVERFIT_URL=http://127.0.0.1:6006
